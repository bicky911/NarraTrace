{
  "manifest_version": 3,
  "name": "NarraTrace Echo-Error Test TTS",
  "version": "1.0.0",
  "description": "Adversarial Chrome TTS fixture that echoes utterances in provider errors.",
  "permissions": ["ttsEngine"],
  "background": { "service_worker": "service-worker.js" },
  "tts_engine": {
    "voices": [
      {
        "voice_name": "NarraTrace Echo-Error Test Voice",
        "lang": "en-US",
        "event_types": ["error"]
      }
    ]
  }
}
