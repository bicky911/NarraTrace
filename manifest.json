{
  "manifest_version": 3,
  "name": "Read Aloud",
  "version": "1.3.0",
  "description": "Personal-use text-to-speech extension powered by local neural TTS engines (Kokoro, Supertonic) and Windows voices.",
  "permissions": [
    "tts",
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "readability.js",
        "sentence-tokenizer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Read Aloud",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-play": {
      "suggested_key": {
        "default": "Alt+P",
        "windows": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Play or pause reading"
    },
    "stop-speech": {
      "suggested_key": {
        "default": "Alt+X",
        "windows": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "Stop reading"
    },
    "skip-forward": {
      "suggested_key": {
        "default": "Alt+Period",
        "windows": "Alt+Period",
        "mac": "Alt+Period"
      },
      "description": "Skip to next sentence"
    },
    "skip-backward": {
      "suggested_key": {
        "default": "Alt+Comma",
        "windows": "Alt+Comma",
        "mac": "Alt+Comma"
      },
      "description": "Skip to previous sentence"
    }
  }
}